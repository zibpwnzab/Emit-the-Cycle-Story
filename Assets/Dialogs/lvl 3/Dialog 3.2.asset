  sentence:
    characterName: "\u042D\u043C\u0438\u0442"
    text: "\u0412\u044B\u0441\u043B\u0443\u0448\u0430\u0442\u044C? \u0427\u0435\u0440\u0435\u0437
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043C\u0438\u043D\u0443\u0442
      \u043C\u0435\u043D\u044F, \u0432\u0441\u0435\u0445 \u043A\u043E\u0433\u043E
      \u044F \u0437\u043D\u0430\u043B \u0438 \u043B\u044E\u0431\u0438\u043B, \u0438
      \u0432\u0441\u0435 \u0447\u0442\u043E \u0431\u044B\u043B\u043E \u0432 \u043E\u043A\u0440\u0443\u0433\u0435
